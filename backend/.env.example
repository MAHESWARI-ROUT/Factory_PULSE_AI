# Copy to .env and fill in for local/production use.

# Local dev default is SQLite; in production (Render) set this to the
# Postgres connection string Render provisions, e.g.:
# postgresql://user:password@host:5432/factorypulse
DATABASE_URL=sqlite:///./factorypulse.db

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional. Without this, the AI Maintenance Assistant and Chat Assistant
# automatically fall back to a rule-based explanation engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
